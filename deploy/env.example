# Copy to deploy/.env and fill in. These are the ONLY secrets/config the
# daemon takes from the environment (DESIGN2 §1) — everything else is
# configured in the UI and stored (encrypted) in Postgres.

# Postgres password for the bundled container.
APOTHECARY_PG_PASSWORD=change-me

# Master key encrypting integration secrets at rest. Generate with:
#   docker run --rm ghcr.io/intradeus/apothecary/apothecaryd:latest keygen
# (plain docker run — compose refuses to start until this key is set)
APOTHECARY_MASTER_KEY=

# Optional: run a pinned release (or a deploy/release.sh local build)
# instead of :latest.
#APOTHECARY_IMAGE=ghcr.io/intradeus/apothecary/apothecaryd:v2.0.1

# Optional: run each run's Docker-in-Docker sandbox under a user-namespace
# container runtime instead of --privileged. Unset (default) = the sandbox is
# --privileged, so root inside it is root on the HOST: one hostile repo or
# prompt injection reaches every other run's checkout, the docker socket and
# APOTHECARY_MASTER_KEY.
#
# Set to sysbox-runc AFTER installing sysbox on the HOST (not in a container —
# https://github.com/nestybox/sysbox/blob/master/docs/user-guide/install.md);
# the sandbox then runs unprivileged and a compromised run is confined to its
# own workspace. Linux only: sysbox can't be installed into Docker Desktop's
# VM (macOS/Windows), so leave this unset there. Startup and the provisioner's
# Test button fail loudly if the daemon has no such runtime.
#APOTHECARY_SANDBOX_RUNTIME=sysbox-runc

# Optional: egress proxy (M18, hostname-filtering). "off" disables it (falls
# back to the derived IP-allowlist firewall); a port number sets the fixed
# loopback port (default 8079). The port is STABLE across restarts so every
# workspace's proxy.env keeps working. Each apothecaryd on the same host
# needs its OWN port.
#APOTHECARY_EGRESS_PROXY=8079
