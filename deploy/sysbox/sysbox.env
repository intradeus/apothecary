# The sysbox release every sysbox node is built from: deploy/k3s/install.sh
# (a real box) and deploy/sysbox/rig.sh (the throwaway node `task
# sandbox:test:sysbox` and CI run on). Sourced by both, read by the Taskfile
# (dotenv). A bump changes the version and both .debs' sha256 together: the
# release page lists each asset's digest, and the asset is
# sysbox-ce_<version>.linux_<arch>.deb (no "-0" since 0.7.0).
# 0.7.1 is the floor: 0.7.0 cannot run on containerd 2 with kernel 6.8+
# (nestybox/sysbox#1013), which every current k3s and Ubuntu are.
SYSBOX_VERSION=0.7.2
SYSBOX_SHA256_AMD64=50cde0e1124c2f028792ca66ab6b3949730ec38768dca1ef93d669802275ddd9
SYSBOX_SHA256_ARM64=b565c1ae4fbd4df4892e771edf121e4308db5b4699402b45768d00cda52ea2e9
