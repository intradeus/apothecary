#!/bin/sh
# The run's WireGuard link to its project's egress gateway — set up once, then
# watched. Runs as a native sidecar (privileged, or NET_ADMIN under sysbox)
# before the sandbox's dockerd starts, in the pod's shared network namespace.
#
#   /secrets/wg/{wg-private-key,wg-ip,gw-public-key}   the run's identity
#   GW_ENDPOINT   the gateway Service's ClusterIP:51820
#   GW_SVC_IP     that ClusterIP alone
#   ENGINE_IP     the engine Service's ClusterIP (or an outside engine's IP)
#
# Afterwards the pod's default route is wg0: everything the sandbox and every
# container in it sends goes through the gateway. Two /32 routes stay on eth0:
# the gateway's endpoint (else the tunnel's own packets would loop into wg0)
# and the engine. The CNI's pod-network routes stay too (replies to the
# engine's dial-in); the network policy is what keeps the pod from using them.
#
# wg reads the private key from /etc/wireguard, never from the secret's
# mount: a host that confines /usr/bin/wg with an AppArmor profile (Ubuntu
# 26.04 ships /etc/apparmor.d/wg) lets it read keys there only, and that
# profile attaches to this container's wg too, a privileged container running
# unconfined.
set -eu
mkdir -p /run/apo
if [ ! -s /run/apo/orig-gw ]; then
  ip -4 route show default | awk '/via/ {print $3; exit}' > /run/apo/orig-gw
fi
ORIG_GW=$(cat /run/apo/orig-gw)
[ -n "$ORIG_GW" ] || { echo "apo-wg-up: no default gateway on eth0" >&2; exit 1; }
# eth0's MTU from netlink, never /sys/class/net: under sysbox with
# hostUsers: false the container's /sys is the host's sysfs (the host's
# interfaces, no eth0 of this pod) and a cat there crash-looped this container.
LINK_MTU=$(ip -o link show dev eth0 | awk '{for (i = 1; i <= NF; i++) if ($i == "mtu") {print $(i + 1); exit}}')
[ -n "$LINK_MTU" ] || { echo "apo-wg-up: no mtu for eth0" >&2; exit 1; }
MTU=$(( LINK_MTU - 60 ))   # outer IPv4 20 + UDP 8 + WireGuard 32

sysctl -qw net.ipv6.conf.all.disable_ipv6=1 net.ipv4.conf.all.rp_filter=0 net.ipv4.conf.default.rp_filter=0 net.ipv4.conf.eth0.rp_filter=0
(umask 077 && mkdir -p /etc/wireguard && cat /secrets/wg/wg-private-key > /etc/wireguard/wg0.key)

# The link: the kernel's WireGuard, else wireguard-go over TUN, the same wg0
# for every wg and ip call after it. A kernel without the module (a Kata
# guest's) refuses the link type; APO_WG_USERSPACE=1 takes userspace on a
# kernel that has it (the live test, so CI covers both). The gateway always
# runs the node's kernel WireGuard; the two interoperate.
MODE=kernel
[ "${APO_WG_USERSPACE:-}" = 1 ] && MODE=userspace
userspace_link() {
  if [ ! -c /dev/net/tun ]; then
    # Not every runtime hands out the TUN device; with CAP_MKNOD (not in a
    # user namespace) it can be made: misc device 10:200.
    mkdir -p /dev/net
    if ! mknod -m 0600 /dev/net/tun c 10 200; then
      echo "apo-wg-up: no /dev/net/tun, and it cannot be made here: no WireGuard link" >&2
      exit 1
    fi
  fi
  # wg configures wireguard-go over its control socket, in
  # /var/run/wireguard, which the hosts' wg AppArmor profile (header) does
  # not let wg reach: keep the socket under /etc/wireguard, which it does.
  mkdir -p /etc/wireguard/run
  if [ ! -L /var/run/wireguard ]; then
    rm -rf /var/run/wireguard
    ln -s /etc/wireguard/run /var/run/wireguard
  fi
  # Foreground, as this script's child: the watchdog sees it die.
  wireguard-go -f wg0 >/run/apo/wireguard-go.log 2>&1 &
  echo $! > /run/apo/wireguard-go.pid
  i=0
  until ip link show wg0 >/dev/null 2>&1; do
    i=$((i + 1))
    if [ "$i" -gt 50 ] || ! kill -0 "$(cat /run/apo/wireguard-go.pid)" 2>/dev/null; then
      echo "apo-wg-up: wireguard-go did not bring up wg0:" >&2
      cat /run/apo/wireguard-go.log >&2
      exit 1
    fi
    sleep 0.1
  done
}
link() {
  if [ "$MODE" = kernel ] && ! ip link show wg0 >/dev/null 2>&1; then
    ip link add wg0 type wireguard 2>/dev/null || MODE=userspace
  fi
  if [ "$MODE" = userspace ] && ! ip link show wg0 >/dev/null 2>&1; then
    userspace_link
  fi
  wg set wg0 private-key /etc/wireguard/wg0.key \
    peer "$(cat /secrets/wg/gw-public-key)" endpoint "$GW_ENDPOINT" allowed-ips 0.0.0.0/0 persistent-keepalive 25
  ip address replace "$(cat /secrets/wg/wg-ip)/32" dev wg0
  ip link set wg0 mtu "$MTU" up
  ip route replace "$GW_SVC_IP/32" via "$ORIG_GW" dev eth0
  ip route replace "$ENGINE_IP/32" via "$ORIG_GW" dev eth0
  ip route replace default dev wg0
}
link
echo "$MTU" > /run/apo/mtu
echo "$MODE" > /run/apo/wg-mode
touch /run/apo/wg-ready
echo "apo-wg-up: wg0 ($MODE WireGuard) $(cat /secrets/wg/wg-ip) → $GW_ENDPOINT (mtu $MTU)"

# Watchdog: a dead wireguard-go takes wg0 (and the default route) with it:
# start it again and put the link back. A replaced gateway pod leaves a
# stale UDP conntrack entry behind the Service IP; a new source port is a
# new flow, freshly translated.
while sleep "${APO_WG_WATCH_EVERY:-60}"; do
  if [ "$MODE" = userspace ] && ! kill -0 "$(cat /run/apo/wireguard-go.pid)" 2>/dev/null; then
    echo "apo-wg-up: wireguard-go exited; restarting it" >&2
    tail -n 5 /run/apo/wireguard-go.log >&2 || true
    link
    continue
  fi
  hs=$(wg show wg0 latest-handshakes | awk '{print $2; exit}')
  if [ $(( $(date +%s) - ${hs:-0} )) -gt 180 ]; then
    echo "apo-wg-up: no handshake for 3m; rebinding" >&2
    wg set wg0 listen-port 0 || true
  fi
done
