# The Kata Containers release every Kata node is built from: deploy/kata/rig.sh
# (the throwaway node `task sandbox:test:kata` and CI run on) and
# deploy/k3s/install.sh --kata (a real box). Sourced by both, read by the
# Taskfile (dotenv). A bump changes the version and its static release's
# sha256 together (amd64; the release page lists it).
KATA_VERSION=4.4.0
KATA_SHA256=ccbc0cbc591089d0c57012b78da64b23ef43e0bac0f869dc7bfebe8588c33986
# The k3s the rig's node runs, and the one the nested-Kubernetes check starts
# inside a Kata sandbox.
K3S_IMAGE=rancher/k3s:v1.36.4-k3s1
