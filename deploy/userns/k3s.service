# k3s as the userns rig's node (deploy/userns/Dockerfile): the server, with
# what the suites do not use left out.
[Unit]
Description=k3s
After=network-online.target

[Service]
Type=notify
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:/opt/k3s/bin/aux:/opt/k3s/bin
ExecStart=/opt/k3s/bin/k3s server --disable traefik --disable metrics-server --disable servicelb
Delegate=yes
KillMode=process
LimitNOFILE=1048576
LimitNPROC=infinity
LimitCORE=infinity
TasksMax=infinity
TimeoutStartSec=0
Restart=always
RestartSec=5s

[Install]
WantedBy=multi-user.target
