# --- secrets ---------------------------------------------------------------
# deployment secrets (APOTHECARY_MASTER_KEY, PG password) — never committed
deploy/.env
# local k3d cluster: its kubeconfig and the engine's master key
deploy/.k3d-kubeconfig
deploy/.k3d-master-key

# --- Go --------------------------------------------------------------------
# locally built binaries go to build/ (`task build`; the image builds its own).
# workspace/ is go:embed'ed into apothecaryd and its gateway tree is hashed into
# the egress-gw image tag, so a stray in-tree `go build` output would ship in
# the daemon and churn the tag — ignore the default output names too.
/build/
/apothecaryd
/gateway
/shim
/workspace/gateway/gateway
/workspace/shim/shim
*.test
cover.out
coverage.*

# --- CPUI (SvelteKit) ------------------------------------------------------
# all generated: dependencies, kit cache, static build output (the deploy
# image builds the CPUI itself)
node_modules/
cpui/.svelte-kit/
cpui/build/
cpui/vite.config.ts.timestamp-*

# --- misc ------------------------------------------------------------------
*.log

# vitest --coverage
cpui/coverage/
cpui/.vitest/
/coverage/
