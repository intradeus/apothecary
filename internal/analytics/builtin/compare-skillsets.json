{
  "id": "builtin-compare-skillsets",
  "name": "Compare skillsets",
  "filters": ["project_id", "flow_name", "ticket_change_type"],
  "panels": [
    {"id": "table", "title": "Skillset versions, ranked", "viz": "table", "width": 12,
     "query": {"grain": "skillsets", "group_by": ["skillset_version"],
       "measures": [
         {"field": "wall_ms", "agg": "median"}, {"field": "wall_ms", "agg": "p90"},
         {"field": "cost_usd", "agg": "median"}, {"field": "attempts", "agg": "avg"},
         {"field": "pings", "agg": "avg"}, {"field": "success_rate"}],
       "score": {"scorecard": "builtin-balanced"}, "order": {"by": "score", "desc": true}}},
    {"id": "wall", "title": "Median wall time by skillset version", "viz": "bar", "width": 6,
     "query": {"grain": "skillsets", "group_by": ["skillset_version"], "measures": [{"field": "wall_ms", "agg": "median"}]}},
    {"id": "spread", "title": "Wall time spread by skillset version", "viz": "box", "width": 6,
     "query": {"grain": "skillsets", "group_by": ["skillset_version"],
       "measures": [
         {"field": "wall_ms", "agg": "p25"}, {"field": "wall_ms", "agg": "median"}, {"field": "wall_ms", "agg": "p75"},
         {"field": "wall_ms", "agg": "min"}, {"field": "wall_ms", "agg": "max"}]}}
  ]
}
