{
  "apiVersion": "v1",
  "kind": "Pod",
  "metadata": {
    "name": "apo-x",
    "labels": {
      "apothecary.io/managed": "true",
      "apothecary.io/project": "p1",
      "apothecary.io/run": "apo-x",
      "apothecary.io/sandbox": "true"
    },
    "annotations": {
      "apothecary.io/project-name": "My App",
      "apothecary.io/shape": "0ffc13846d23d323"
    }
  },
  "spec": {
    "restartPolicy": "Always",
    "terminationGracePeriodSeconds": 30,
    "automountServiceAccountToken": false,
    "enableServiceLinks": false,
    "hostname": "apo-x",
    "initContainers": [
      {
        "name": "shim-seed",
        "image": "shim:1",
        "args": [
          "seed",
          "/var/lib/apothecary/runs/apo-x/shim"
        ],
        "volumeMounts": [
          {
            "name": "data",
            "mountPath": "/var/lib/apothecary/runs/apo-x",
            "subPath": "run"
          }
        ]
      },
      {
        "name": "tools-seed",
        "image": "tools:1",
        "args": [
          "/var/lib/apothecary/runs/apo-x/tools"
        ],
        "volumeMounts": [
          {
            "name": "data",
            "mountPath": "/var/lib/apothecary/runs/apo-x",
            "subPath": "run"
          }
        ]
      },
      {
        "name": "relay",
        "image": "shim:1",
        "args": [
          "relay",
          "--serve",
          "0.0.0.0:7070",
          "--dir",
          "/var/lib/apothecary/runs/apo-x/shim",
          "--token-file",
          "/secrets/run/relay-token"
        ],
        "ports": [
          {
            "name": "relay",
            "containerPort": 7070
          }
        ],
        "volumeMounts": [
          {
            "name": "data",
            "mountPath": "/var/lib/apothecary/runs/apo-x",
            "subPath": "run"
          },
          {
            "name": "run-secret",
            "mountPath": "/secrets/run",
            "readOnly": true
          }
        ],
        "restartPolicy": "Always",
        "resources": {
          "requests": {
            "cpu": "10m",
            "memory": "32Mi"
          }
        }
      }
    ],
    "containers": [
      {
        "name": "sandbox",
        "image": "sbx:1",
        "command": [
          "apo-dockerd"
        ],
        "env": [
          {
            "name": "DOCKER_TLS_CERTDIR"
          }
        ],
        "volumeMounts": [
          {
            "name": "data",
            "mountPath": "/var/lib/docker",
            "subPath": "docker"
          },
          {
            "name": "data",
            "mountPath": "/var/lib/apothecary/runs/apo-x",
            "subPath": "run"
          },
          {
            "name": "apo",
            "mountPath": "/run/apo"
          }
        ],
        "securityContext": {
          "privileged": true
        },
        "readinessProbe": {
          "exec": {
            "command": [
              "docker",
              "version"
            ]
          },
          "periodSeconds": 3,
          "timeoutSeconds": 5,
          "failureThreshold": 100
        },
        "resources": {
          "requests": {
            "cpu": "100m",
            "memory": "1024Mi"
          },
          "limits": {
            "cpu": "16000m",
            "memory": "65536Mi"
          }
        }
      }
    ],
    "volumes": [
      {
        "name": "apo",
        "emptyDir": {}
      },
      {
        "name": "run-secret",
        "secret": {
          "secretName": "apo-run-apo-x",
          "defaultMode": 256
        }
      },
      {
        "name": "data",
        "persistentVolumeClaim": {
          "claimName": "apo-x-data"
        }
      }
    ]
  },
  "status": {}
}
