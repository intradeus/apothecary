{
  "uid": "apothecary-humans",
  "title": "Apothecary \u00b7 Humans in the loop",
  "description": "What the runs ask of people: pings by type, how long answers take, holds.",
  "tags": [
    "apothecary",
    "humans"
  ],
  "editable": true,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timezone": "",
  "templating": {
    "list": [
      {
        "name": "prom",
        "label": "Prometheus",
        "type": "datasource",
        "query": "prometheus",
        "regex": "",
        "hide": 0,
        "refresh": 1,
        "current": {},
        "options": [],
        "includeAll": false,
        "multi": false
      },
      {
        "name": "loki",
        "label": "Loki",
        "type": "datasource",
        "query": "loki",
        "regex": "",
        "hide": 0,
        "refresh": 1,
        "current": {},
        "options": [],
        "includeAll": false,
        "multi": false
      },
      {
        "name": "tempo",
        "label": "Tempo",
        "type": "datasource",
        "query": "tempo",
        "regex": "",
        "hide": 0,
        "refresh": 1,
        "current": {},
        "options": [],
        "includeAll": false,
        "multi": false
      },
      {
        "name": "pg",
        "label": "Postgres (fact tables)",
        "type": "datasource",
        "query": "grafana-postgresql-datasource",
        "regex": "",
        "hide": 0,
        "refresh": 1,
        "current": {},
        "options": [],
        "includeAll": false,
        "multi": false
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Pings raised by type",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${prom}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${prom}"
          },
          "refId": "A",
          "expr": "sum by (type) (increase(apothecary_pings_total[$__rate_interval]))",
          "legendFormat": "{{type}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Answer wait p50 / p95 by type",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${prom}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${prom}"
          },
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le, type) (rate(apothecary_ping_answer_wait_seconds_bucket[$__rate_interval])))",
          "legendFormat": "p50 {{type}}",
          "range": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${prom}"
          },
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le, type) (rate(apothecary_ping_answer_wait_seconds_bucket[$__rate_interval])))",
          "legendFormat": "p95 {{type}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Holds taken",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${prom}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${prom}"
          },
          "refId": "A",
          "expr": "sum(increase(apothecary_holds_total[$__rate_interval]))",
          "legendFormat": "holds",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 4,
      "type": "table",
      "title": "Pings over the range by type",
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${prom}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${prom}"
          },
          "refId": "A",
          "expr": "sum by (type) (increase(apothecary_pings_total[$__range]))",
          "legendFormat": "",
          "format": "table",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    }
  ]
}
