{
	"name": "apothecary-cpui",
	"private": true,
	"version": "0.1.0",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"check:themes": "node scripts/check-themes.mjs",
		"lint": "npm run lint:code && npm run lint:styles && npm run lint:tokens && npm run lint:layers && npm run lint:tests && npm run check:themes && npm run lint:format",
		"lint:code": "eslint .",
		"lint:styles": "stylelint \"src/**/*.{css,svelte}\"",
		"lint:tokens": "node scripts/check-tokens.mjs",
		"lint:layers": "node scripts/check-layers.mjs",
		"lint:tests": "node scripts/check-tests.mjs",
		"lint:format": "prettier --check .",
		"format": "prettier --write ."
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@hey-api/openapi-ts": "^0.99.0",
		"@sveltejs/adapter-static": "^3.0.8",
		"@sveltejs/kit": "^2.20.0",
		"@sveltejs/vite-plugin-svelte": "^5.0.0",
		"@testing-library/jest-dom": "^7.0.1",
		"@testing-library/svelte": "^5.4.2",
		"@testing-library/user-event": "^14.6.8",
		"@types/node": "^26.1.1",
		"@vitest/coverage-v8": "^5.0.5",
		"eslint": "^10.14.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.1",
		"globals": "^17.13.0",
		"jsdom": "^29.1.1",
		"postcss-html": "^2.0.0",
		"prettier": "^3.9.6",
		"prettier-plugin-svelte": "^4.1.1",
		"stylelint": "^17.16.0",
		"svelte": "^5.20.0",
		"svelte-check": "^4.1.0",
		"typescript": "^5.7.0",
		"typescript-eslint": "^8.72.1",
		"vite": "^6.2.0",
		"vitest": "^5.0.5"
	},
	"dependencies": {
		"@codemirror/autocomplete": "^6.20.4",
		"@codemirror/lang-markdown": "6.5.2",
		"@codemirror/lang-yaml": "^6.1.3",
		"@codemirror/language": "^6.13.1",
		"@codemirror/lint": "^6.9.7",
		"@codemirror/state": "^6.7.6",
		"@codemirror/view": "^6.43.15",
		"@lezer/common": "^1.5.4",
		"@lezer/highlight": "^1.2.5",
		"@xterm/addon-fit": "^0.10.0",
		"@xterm/xterm": "^5.5.0",
		"@xyflow/svelte": "^1.6.2",
		"codemirror": "^6.0.2",
		"codemirror-json-schema": "^0.8.1",
		"marked": "^18.0.6",
		"yaml": "^2.9.0"
	}
}
